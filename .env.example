# Discord application (discord.com/developers). Use a separate dev app + dev guild locally:
# two gateway sessions on one token would both answer every trigger.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
GUILD_ID=

# Service URLs as seen from inside the compose network.
REDIS_URL=redis://redis:6379
LT_URL=http://libretranslate:5000

# Optional. Leave blank and Redis accepts unauthenticated connections, which is
# fine when it is the only thing on its compose network. SET IT if the host runs
# other containers: without it, any of them can read every cached message. The
# same value configures the server and the bot, so setting it here is enough.
REDIS_PASSWORD=

# Translation backend: libretranslate | ollama (ollama is a stub in phase 1)
BACKEND=libretranslate

# Cache TTL for translations and their source text. Default 30 days.
CACHE_TTL_SECONDS=2592000

# Abuse ceilings, not throttles. Budgets rather than a delay between requests,
# because a fast-moving thread has one person translating several messages in a
# row — well under 20 a minute, while sustained abuse is not. Every request
# counts, cache hits included. Exceeding the user budget gets a private notice;
# on the public triggers (@mention, flag reaction) the bot just stays quiet.
RATE_LIMIT_USER_PER_MIN=20
RATE_LIMIT_GUILD_PER_HOUR=2000

# LOCAL ONLY. Limits which LibreTranslate models download (~10 GB for the full set).
# Leave unset on the VPS so every language loads.
LT_LOAD_ONLY=en,es,fr,de,nl,pt,pb

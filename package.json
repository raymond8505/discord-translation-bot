{
  "name": "discord-translation-bot",
  "version": "0.1.0",
  "description": "Self-hosted, on-demand Discord translation via LibreTranslate, cached in Redis.",
  "private": true,
  "license": "LicenseRef-PolyForm-Noncommercial-1.0.0",
  "author": "Raymond Selzer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raymond8505/discord-translation-bot.git"
  },
  "type": "module",
  "engines": {
    "node": "24.16.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest",
    "test:run": "vitest run",
    "deploy-commands": "tsx --env-file-if-exists=.env scripts/deploy-commands.ts",
    "locales:generate": "tsx scripts/generate-locales.ts",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:restart": "docker compose up --build -d --force-recreate bot",
    "docker:restart:lt": "docker compose up -d --force-recreate libretranslate",
    "docker:watch": "docker compose watch",
    "docker:logs": "docker compose logs -f bot",
    "docker:logs:all": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:cache": "docker compose exec redis sh -c 'redis-cli ${REDIS_PASSWORD:+--no-auth-warning -a \"$REDIS_PASSWORD\"} --scan --pattern \"tr:*\"'",
    "docker:languages": "docker compose exec bot node -e \"fetch('http://libretranslate:5000/languages').then(r=>r.json()).then(l=>console.log(l.map(x=>x.code).join(', ')))\"",
    "postinstall": "node .husky/install.mjs"
  },
  "lint-staged": {
    "*.{ts,mjs}": "eslint --max-warnings 0"
  },
  "packageManager": "yarn@4.17.0+sha512.c2957de2f9025ab14d63b24d0d8be1f1655810e22c341042c27f7ecd017b180ec12db73d69ac366d71b304ef9f069349ce462de96f04f8f1da317f4f762c95ae",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "redis": "^6.2.1",
    "zod": "^4.5.4"
  }
}
